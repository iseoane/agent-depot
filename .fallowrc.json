{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.30.0",
  "entry": [
    "src/cli.ts",
    "tests/**/*.test.ts"
  ],
  "ignorePatterns": [
    "dist/**",
    ".scratch/**",
    ".codegraph/**",
    ".atl/**",
    ".fallow/**",
    "coverage/**",
    "skills/doctor-md-skill/assets/pierre-diffs.js"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "cli",
        "patterns": [
          "src/cli.ts"
        ]
      },
      {
        "name": "tui",
        "patterns": [
          "src/tui/**"
        ]
      },
      {
        "name": "application",
        "patterns": [
          "src/project-installation.ts",
          "src/skill-update.ts",
          "src/update-batch.ts",
          "src/user-global-skill-inventory.ts",
          "src/skill-adoption.ts",
          "src/user-method.ts",
          "src/skill-hosts.ts",
          "src/skill-install.ts",
          "src/skill-removal.ts",
          "src/unmanaged-removal.ts",
          "src/update-flow.ts"
        ]
      },
      {
        "name": "core",
        "patterns": [
          "src/sources.ts",
          "src/source-state.ts",
          "src/skill-discovery.ts",
          "src/project-manifest.ts"
        ]
      },
      {
        "name": "infrastructure",
        "patterns": [
          "src/git-source.ts",
          "src/path-safety.ts",
          "src/process-runner.ts",
          "src/version.ts",
          "src/usage-error.ts"
        ]
      },
      {
        "name": "tooling",
        "patterns": [
          "scripts/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "cli",
        "allow": [
          "tui",
          "application",
          "core",
          "infrastructure"
        ]
      },
      {
        "from": "tui",
        "allow": [
          "application",
          "core",
          "infrastructure"
        ]
      },
      {
        "from": "application",
        "allow": [
          "core",
          "infrastructure"
        ]
      },
      {
        "from": "core",
        "allow": [
          "infrastructure"
        ]
      },
      {
        "from": "infrastructure",
        "allow": []
      },
      {
        "from": "tooling",
        "allow": []
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "tests/**",
        "eslint.config.js"
      ]
    }
  },
  "duplicates": {
    "threshold": 6
  }
}
