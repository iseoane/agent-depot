+const agentSnapshotRequest = Type.Object({
+  version: Type.Literal(1),
+  requestId: Type.String(),
+});
+
+function registerAgentSnapshotProvider(pi: ExtensionAPI, runner: AgentRunner): void {
+  pi.events.on("agent-depot:agents:v1:request", (payload) => {
+    if (!Value.Check(agentSnapshotRequest, payload)) return;
+    pi.events.emit("agent-depot:agents:v1:snapshot", {
+      version: 1,
+      requestId: payload.requestId,
+      agents: runner.snapshot(),
+    });
+  });
+}
